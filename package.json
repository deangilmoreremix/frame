{
  "name": "frame",
  "version": "1.0.0",
  "private": true,
  "description": "Frame: AI-Powered Video Editing with a Code-Like Creative Flow",
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "build:netlify": "pnpm install && pnpm --filter @frame/common run build && pnpm --filter @frame/backend run build && pnpm --filter @frame/web run build",
    "dev": "pnpm -r --parallel --filter \"./packages/*\" run dev",
    "test": "pnpm -r --filter \"./packages/*\" run test",
    "lint": "pnpm -r --filter \"./packages/*\" run lint",
    "typecheck": "pnpm -r --filter \"./packages/*\" run typecheck",
    "clean": "pnpm -r --filter \"./packages/*\" run clean",
    "supabase:init": "supabase init",
    "db:push": "yes | supabase db push --db-url \"$SUPABASE_DB_URL\"",
    "db:diff": "supabase db diff -f",
    "netlify:dev": "netlify dev",
    "netlify:build": "netlify build",
    "netlify:deploy": "netlify deploy --prod",
    "netlify:login": "netlify login"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/deangilmoreremix/frame.git"
  },
  "keywords": [
    "AI Agent for Video Editing",
    "Video Editing",
    "AI",
    "Agent",
    "Video"
  ],
  "homepage": "https://cursorfor.video/",
  "author": "Terry Zhang <terry@llamagen.ai>",
  "license": "MIT",
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.0.0",
    "@types/pg": "^8.20.0",
    "eslint": "^8.57.0",
    "netlify-cli": "^26.2.0",
    "pg": "^8.22.0",
    "prettier": "^3.2.0",
    "supabase": "2.0.0",
    "typescript": "^5.4.0"
  }
}
