    "@frame/common": "workspace:*",
    "@netlify/functions": "^5.3.0",
    "@supabase/supabase-js": "^2.110.7",
    "fastify": "^4.27.0",
    "uuid": "^9.0.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^9.0.8",
    "pg": "^8.22.0",
    "tsx": "^4.10.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
