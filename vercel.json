{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm install && pnpm --filter @frame/web run build",
  "outputDirectory": "packages/frame-web/.next",
  "installCommand": "pnpm install",
  "framework": "nextjs",
  "rootDirectory": ".",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://frame-backend.vercel.app/api/:path*"
    }
  ],
  "env": {
    "NEXT_PUBLIC_API_URL": "/api"
  }
}
